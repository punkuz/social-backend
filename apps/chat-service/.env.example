RABBITMQ_URL=amqp://localhost:5672
CHAT_QUEUE=chat_queue
HEALTH_PORT=3002
MONGODB_URI=mongodb://localhost:27017/social_chat
MONGODB_MIN_POOL_SIZE=2
MONGODB_MAX_POOL_SIZE=20
MONGODB_AUTO_INDEX=true
JWT_SECRET=replace-with-a-long-random-secret
MESSAGE_RECEIPT_SECRET=

# Kafka topics must be created by infrastructure before this service starts.
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=chat-storage
KAFKA_CHAT_MESSAGES_TOPIC=chat.messages.v1
KAFKA_CHAT_RECEIPTS_TOPIC=chat.receipts.v1
KAFKA_CHAT_MESSAGES_DLQ_TOPIC=chat.messages.dlq.v1
KAFKA_STORAGE_GROUP_ID=chat-storage-v1
KAFKA_STORAGE_BATCH_SIZE=500
KAFKA_STORAGE_CONCURRENCY=3
KAFKA_SSL=false
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
