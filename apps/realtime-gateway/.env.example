PORT=3001
INSTANCE_ID=realtime-1
WS_CORS_ORIGINS=http://localhost:4200

# Local Redis. Used when REDIS_CLUSTER_NODES is empty.
REDIS_URL=redis://localhost:6379

# Production Redis 7 cluster. Comma-separated URLs enable sharded Pub/Sub.
REDIS_CLUSTER_NODES=

# Must match the key used by api-gateway when issuing access tokens.
JWT_SECRET=replace-me

# Shared by every realtime-gateway instance. Keep it different from JWT_SECRET.
MESSAGE_RECEIPT_SECRET=replace-with-a-long-random-secret
PRESENCE_TTL_SECONDS=90
WS_MESSAGE_RATE_PER_SECOND=20
WS_RECEIPT_RATE_PER_SECOND=60
WS_TYPING_RATE_PER_SECOND=10
CONVERSATION_CACHE_TTL_SECONDS=21600
RABBITMQ_URL=amqp://localhost:5672
CHAT_QUEUE=chat_queue

# Kafka topic must be created by infrastructure before this service starts.
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=realtime-gateway-producer
KAFKA_CHAT_MESSAGES_TOPIC=chat.messages.v1
KAFKA_CHAT_RECEIPTS_TOPIC=chat.receipts.v1
KAFKA_FANOUT_GROUP_ID=realtime-fanout-v1
KAFKA_FANOUT_CONCURRENCY=3
KAFKA_SSL=false
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
